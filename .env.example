# =========================================================================
# JEXA AI COMPANION - PRODUCTION ENVIRONMENT CONFIGURATION
# Powered by JOHNEY TEC
# =========================================================================

# =========================================================================
# 1. FRONTEND CONFIGURATION (Client-Safe / GitHub Actions Repository Variables)
# =========================================================================
# NOTE: Set in GitHub Settings -> Secrets and variables -> Actions -> Variables
# NEVER put private server secrets, LiteLLM URLs, or API keys in VITE_* variables.
# -------------------------------------------------------------------------
# Set to your deployed Render JEXA backend URL (e.g., https://jexa-ai.onrender.com)
VITE_API_BASE_URL=https://your-render-service.onrender.com

# Optional base path override (defaults to dynamic /<repo-name>/ in GitHub Actions)
VITE_BASE_PATH=

# =========================================================================
# 2. RENDER BACKEND ONLY (Server-Side Private Environment Variables)
# =========================================================================
# NOTE: Configure exclusively in your Render Dashboard -> Environment.
# NEVER commit real secrets to GitHub.
# -------------------------------------------------------------------------
PORT=10000
NODE_ENV=production
FRONTEND_URL=
CORS_ORIGIN=
CORS_ALLOWED_ORIGINS=

# --- Private LiteLLM AI Gateway (Phase 1) ---
# Internal Render Private Service host:port or http:// URL (e.g., jexa-litellm-gateway:4000 or http://jexa-litellm-gateway:4000)
# Never expose LITELLM_BASE_URL or LiteLLM keys to the frontend.
LITELLM_BASE_URL=
LITELLM_MASTER_KEY=
LITELLM_API_KEY=
# Set to true in production to fail closed (503) instead of bypassing LiteLLM directly to Gemini
ENFORCE_LITELLM_GATEWAY=true

# --- AI Provider API Keys (Server / LiteLLM Gateway) ---
# Google Gemini API Key (used by LiteLLM gateway, Gemini Live / Voice TTS, and direct fallback when gateway is unenforced)
GEMINI_API_KEY=
AI_API_KEY=
# Groq API Key (used by LiteLLM gateway for ultra-fast fallback & Groq routing)
GROQ_API_KEY=

# --- Text & Background Model Routing ---
# Set TEXT_AI_PROVIDER=litellm (or leave empty to auto-select 'litellm' when configured/enforced).
TEXT_AI_PROVIDER=litellm
TEXT_AI_MODEL=gemini-3.8-flash
TEXT_AI_BACKUP_MODEL=gemini-3.7-flash
BACKGROUND_AI_MODEL=gemini-3.5-flash-lite

# --- Real Voice / TTS Configuration (Gemini Native Audio - Direct Backend) ---
VOICE_AI_PROVIDER=gemini
VOICE_AI_API_KEY=
VOICE_AI_MODEL=gemini-3.8-flash-lite-tts

# --- Live Web Search (Tavily Search API) ---
# Private backend API key for real-time live internet search
TAVILY_API_KEY=

# --- Distributed Rate Limiting (Upstash Redis REST) ---
# When configured, critical endpoints fail closed (503) in production if Upstash is unreachable unless RATE_LIMIT_FAIL_CLOSED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_FAIL_CLOSED=true
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_VOICE_MAX=15
RATE_LIMIT_ADMIN_MAX=30
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GENERAL_MAX=60

# --- Server-Side Authentication, Owner RBAC & Durable Audit Logs (Supabase) ---
# Owner setup process:
#   1. Create your account in Supabase Authentication -> Users (confirm email).
#   2. Set SUPABASE_URL and SUPABASE_ANON_KEY on Render (backend-only).
#   3. Copy your Supabase User UUID and set OWNER_USER_ID=<uuid> (takes strict precedence).
#   4. Optionally set OWNER_EMAIL=<your-email> as fallback only if OWNER_USER_ID is unset.
#   5. Apply supabase/security_audit_logs.sql in Supabase SQL Editor and set SUPABASE_SERVICE_ROLE_KEY for durable audit logs.
# Never hardcode owner IDs, emails, or service keys in source code or VITE_* frontend variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SECURITY_AUDIT_TABLE=jexa_security_audit_logs
AUTH_CACHE_TTL_MS=5000
OWNER_USER_ID=
OWNER_EMAIL=
# Normal chat & voice stay open unless REQUIRE_AUTH_FOR_CHAT=true; admin/tools/security endpoints ALWAYS require Owner auth.
REQUIRE_AUTH_FOR_CHAT=false
