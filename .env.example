# =========================================================================
# JEXA AI COMPANION - PRODUCTION ENVIRONMENT CONFIGURATION
# Powered by JOHNEY TEC
# =========================================================================

# =========================================================================
# 1. FRONTEND CONFIGURATION (Client-Safe / GitHub Actions Repository Variables)
# =========================================================================
# NOTE: Set in GitHub Settings -> Secrets and variables -> Actions -> Variables
# NEVER put private server secrets or API keys in VITE_* variables.
# -------------------------------------------------------------------------
# Set to your deployed Render service URL (e.g., https://jexa-ai.onrender.com)
VITE_API_BASE_URL=https://your-render-service.onrender.com

# Optional base path override (defaults to dynamic /<repo-name>/ in GitHub Actions)
VITE_BASE_PATH=

# =========================================================================
# 2. RENDER BACKEND ONLY (Server-Side Private Environment Variables)
# =========================================================================
# NOTE: Configure exclusively in your Render Dashboard -> Environment.
# NEVER commit these keys to GitHub.
# -------------------------------------------------------------------------
PORT=10000
NODE_ENV=production

# --- Real AI API Keys: Gemini ---
# Google Gemini API Key for conversational reasoning and native TTS
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=
TEXT_AI_PROVIDER=gemini
TEXT_AI_MODEL=gemini-3.8-flash

# --- Real AI API Keys: Groq ---
# High-speed LPU inference via Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Real Voice / TTS Configuration: Gemini & ElevenLabs ---
# Options: gemini | elevenlabs
VOICE_AI_PROVIDER=gemini
VOICE_AI_API_KEY=
VOICE_AI_MODEL=gemini-3.8-flash-lite-tts

# ElevenLabs Speech Synthesis
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- JEXA Personal Voice Engine (Foundation) ---
# Engine adapter: none (default) | xtts | piper | custom
PERSONAL_VOICE_ENGINE=none
PERSONAL_VOICE_MODEL=
PERSONAL_VOICE_REFERENCE_ID=
PERSONAL_VOICE_API_URL=
PERSONAL_VOICE_API_KEY=

# --- Supabase Persistent Database & Memory ---
# Supabase project URL and service role key (for server-side persistent conversation storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
