# =========================================================================
# JEXA AI Companion - Environment Configuration
# Powered by JOHNEY TEC
# =========================================================================

# Server Runtime & Port
PORT=3000
NODE_ENV=development

# -------------------------------------------------------------------------
# 1. TEXT AI PROVIDER CONFIGURATION
# -------------------------------------------------------------------------
# Options: development_mock | gemini | openai | anthropic | custom_http
TEXT_AI_PROVIDER=development_mock
TEXT_AI_API_KEY=
TEXT_AI_MODEL=jexa-foundation-v1
TEXT_AI_TEMPERATURE=0.7
TEXT_AI_MAX_TOKENS=2048
# TEXT_AI_ENDPOINT=https://api.openai.com/v1/chat/completions

# -------------------------------------------------------------------------
# 2. VOICE AI PROVIDER CONFIGURATION
# -------------------------------------------------------------------------
# Options: development_mock | elevenlabs | openai_voice | browser_speech | custom_tts
VOICE_AI_PROVIDER=development_mock
VOICE_AI_API_KEY=
VOICE_AI_MODEL=jexa-voice-neural-1
VOICE_AI_VOICE_ID=aura-jexa-serene
# VOICE_AI_ENDPOINT=https://api.elevenlabs.io/v1/text-to-speech

# -------------------------------------------------------------------------
# 3. SUPABASE DATABASE & PERSISTENT MEMORY
# -------------------------------------------------------------------------
# Leave blank to run with seamless in-memory fallback during local prototyping
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
