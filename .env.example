# =========================================================================
# JEXA AI Companion - Environment Configuration
# Powered by JOHNEY TEC
# =========================================================================

# Server Runtime & Port (Render / Local Node Server)
PORT=3000
NODE_ENV=development

# -------------------------------------------------------------------------
# FRONTEND API CONFIGURATION (GitHub Pages -> Render Backend)
# -------------------------------------------------------------------------
# In local development: leave blank (defaults to '/api' proxied by Express)
# In production on GitHub Pages: set to your Render backend URL (no trailing slash)
# Example: https://jexa-backend.onrender.com
VITE_API_BASE_URL=
VITE_BASE_PATH=./

# -------------------------------------------------------------------------
# 1. TEXT AI PROVIDER CONFIGURATION
# -------------------------------------------------------------------------
# Options: gemini | development_mock | openai | anthropic | custom_http
GEMINI_API_KEY=
AI_API_KEY=
TEXT_AI_PROVIDER=gemini
TEXT_AI_API_KEY=
TEXT_AI_MODEL=gemini-3.8-flash
TEXT_AI_TEMPERATURE=0.7
TEXT_AI_MAX_TOKENS=1024
# TEXT_AI_ENDPOINT=https://api.openai.com/v1/chat/completions

# -------------------------------------------------------------------------
# 2. VOICE AI PROVIDER CONFIGURATION
# -------------------------------------------------------------------------
# Options: development_mock | elevenlabs | openai_voice | browser_speech | custom_tts
VOICE_AI_PROVIDER=development_mock
VOICE_AI_API_KEY=
VOICE_AI_MODEL=jexa-voice-neural-1
VOICE_AI_VOICE_ID=aura-jexa-serene
# VOICE_AI_ENDPOINT=https://api.elevenlabs.io/v1/text-to-speech

# -------------------------------------------------------------------------
# 3. SUPABASE DATABASE & PERSISTENT MEMORY
# -------------------------------------------------------------------------
# Leave blank to run with seamless in-memory fallback during local prototyping
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
